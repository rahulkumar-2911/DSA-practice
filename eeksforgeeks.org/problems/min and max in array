class Solution {
    public ArrayList<Integer> getMinMax(int[] arr) {
        // code Here
        int mx = arr[0];
        int mn = arr[0];
        
        for(int i =1; i<arr.length; i++){
            if(arr[i] <mn){
                mn =arr[i];
            }
            if(arr[i] > mx){
                mx =arr[i];
            }
        }
        ArrayList<Integer> result = new ArrayList<>();
                result.add(mn);
                result.add(mx);
                return result;
    }
}
